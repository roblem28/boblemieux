# Copy to .env.local for local development. Real values live in Netlify site env.

# /tools/p6 status card: base URL of the private P6 Parser service (tailnet-only,
# via tailscale serve). No trailing slash. Inlined into the client bundle at build.
NEXT_PUBLIC_P6_TOOL_URL=https://your-host.your-tailnet.ts.net:8443
